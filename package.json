{
  "name": "music-player-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist --port 8788",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "d1:init:local": "wrangler d1 execute DB --local --file=schema.sql",
    "d1:init:remote": "wrangler d1 execute DB --remote --file=schema.sql"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tone": "^15.1.22",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  }
}
